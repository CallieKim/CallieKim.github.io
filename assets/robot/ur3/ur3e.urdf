<?xml version="1.0"?>
<robot name="ur3e">
  <!-- Kinematic URDF for IK solver with collision primitives from ur3.xml. -->
  <!-- Joint origins match the Three.js makeFrame() calls in robot-animation.js -->
  <!-- Permanently-near pairs are fine: ik-loader runs computeAverageDistanceTable() -->
  <!-- after solver construction, which normalizes them away. -->

  <link name="base_link">
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.09" radius="0.065"/>
      </geometry>
    </collision>
  </link>

  <link name="shoulder_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.11" radius="0.065"/>
      </geometry>
    </collision>
  </link>

  <link name="upper_arm_link">
    <collision>
      <origin xyz="-0.127 0 0.12" rpy="1.570796327 0 -1.570796327"/>
      <geometry>
        <cylinder length="0.145" radius="0.05"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 -1.570796327"/>
      <geometry>
        <cylinder length="0.11" radius="0.05"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.245 0 0.125" rpy="0 0 -1.570796327"/>
      <geometry>
        <cylinder length="0.11" radius="0.04"/>
      </geometry>
    </collision>
  </link>

  <link name="forearm_link">
    <collision>
      <origin xyz="-0.07 0 0.027" rpy="1.570796327 0 -1.570796327"/>
      <geometry>
        <cylinder length="0.20" radius="0.04"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.215 0 0.027" rpy="0 0 -1.570796327"/>
      <geometry>
        <cylinder length="0.095" radius="0.04"/>
      </geometry>
    </collision>
  </link>

  <link name="wrist_1_link">
    <collision>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <geometry>
        <cylinder length="0.095" radius="0.035"/>
      </geometry>
    </collision>
  </link>

  <link name="wrist_2_link">
    <collision>
      <origin xyz="0 -0.008 0.005" rpy="1.570796327 0 0"/>
      <geometry>
        <cylinder length="0.1" radius="0.04"/>
      </geometry>
    </collision>
  </link>

  <link name="wrist_3_link">
    <collision>
      <origin xyz="0 -0.005 -0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.04"/>
      </geometry>
    </collision>
  </link>

  <!-- tool0 sits at the gripper pad center (0.13 out along wrist_3 +Z); the
       box approximates the whole Robotiq 2F-85 volume from flange to tips -->
  <link name="tool0">
    <collision>
      <origin xyz="0 0 -0.055" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.09 0.13"/>
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.1519" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="56.0" velocity="3.14159265"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="56.0" velocity="3.14159265"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="-0.24365 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653" upper="3.141592653" effort="28.0" velocity="3.14159265"/>
  </joint>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="-0.21325 0 0.11235" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="12.0" velocity="6.28318530"/>
  </joint>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 -0.08535 0" rpy="1.570796327 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="12.0" velocity="6.28318530"/>
  </joint>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0.0819 0" rpy="1.570796327 3.141592654 3.141592654"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307" upper="6.283185307" effort="12.0" velocity="6.28318530"/>
  </joint>

  <joint name="wrist_3_link-tool0" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
  </joint>

</robot>
